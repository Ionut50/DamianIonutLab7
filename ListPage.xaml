<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DamianIonutLab7.ListPage"
             xmlns:local="clr-namespace:DamianIonutLab7"
             Title="ListPage">
    <StackLayout Margin="20">
        <Editor Placeholder="Enter the description of the shopping list"            
                Text="{Binding Description}"            
                HeightRequest="50"  >
            <Editor.Behaviors>
                <local:ValidationBehaviour />
            </Editor.Behaviors>
        </Editor>
        <Picker x:Name="ShopPicker" Title="Enter Shop Name"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Text="Save List"                 
                    Clicked="OnSaveButtonClicked" />
            <Button Grid.Column="1"                   
                    Text="Delete List"              
                    Clicked="OnDeleteButtonClicked"/>
        </Grid>

        <ListView x:Name="listView"             
                  Margin="20"
                  SelectedItem="{Binding SelectedProduct}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Detail="{Binding Description}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0" 
                    Text="Add Item" 
                    Clicked="OnChooseButtonClicked"/>

            <Button Grid.Column="1" 
                    Text="Delete Item" 
                    BackgroundColor="Red"
                    Clicked="OnDeleteItemButtonClicked"/>
        </Grid>

    </StackLayout>
</ContentPage>